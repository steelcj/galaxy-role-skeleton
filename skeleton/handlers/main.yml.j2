---
# handlers file for {{ role_name }}

- name: Restart {{ role_name }}
  ansible.builtin.systemd_service:
    name: "{{ '{{' }} {{ role_name }}_service {{ '}}' }}"
    state: restarted
  when:
    - {{ role_name }}_service | length > 0
    - ansible_connection not in {{ role_name }}_skip_connections
